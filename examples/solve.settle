# SOLVE: real-valued numbers on springs. Shake them, and their average position solves a linear system;
# the spread of their positions, divided by the temperature, is the inverse matrix.

model :bowl do
  number :x, :y, :z
  x.springs :y, by: 0.5          # a spring pulling x and y together
  y.opposes :z, by: 0.25         # a spring pulling y towards minus z
  x.leans_to 2.0, by: 1          # a spring tying x to the value 2
  y.leans_to -1.0, by: 0.5
  z.leans_to 0.5, by: 2
end

run :bowl do
  drift 400_000, step: 0.02, temperature: 1, seed: 1
  means                          # the settled averages against an exact solve
  spread                         # the covariance, and the inverse it gives
end

model :system do
end

run :system do
  # build the springs for A x = b straight from a matrix, and settle them
  solve :a, :b, :c, matrix: "4 1 0; 1 3 1; 0 1 2", target: "1 2 3", steps: 400_000, step: 0.02
  spread
end

# Uncomment either line to see a refusal. A non-symmetric matrix is not a set of springs:
#   solve :p, :q, matrix: "2 1; 0 3", target: "1 1"
# and a matrix with a negative stiffness has no valley, so it never settles:
#   solve :p, :q, matrix: "1 2; 2 1", target: "1 1"
