# Learning from examples: three 3x3 glyphs (plus, cross, ring), 12% of pixels flipped, 90 to learn from
# and 90 to test on. Pixels (tl = top left ... br = bottom right) and label names are all things; learning
# fits their leans and pulls. classify holds the nine pixels of each test glyph and lets the labels settle.

model :glyphs do
  examples :train, over: "tl tm tr ml mm mr bl bm br plus cross ring"
  examples :test, over: "tl tm tr ml mm mr bl bm br plus cross ring"
  examples :train, rows: "010111011100 001000101010 100101110001 010111011100 101010101010 111101111001 011111010100 101010100010 011101111001 010111010100 111010101010 101101111001 010101010100 101010010010 110100111001"
  examples :train, rows: "010110010100 001010011010 111101111001 010111110100 101010100010 101101111001 010111000100 101011101010 111101111001 010101010100 101010101010 110011111001 010110010100 101011110010 101100111001"
  examples :train, rows: "110111011100 110010100010 111001111001 010110010100 101010101010 111101010001 001111010100 100010101010 011101101001 010111010100 101110101010 111111110001 010111010100 001010101010 111101110001"
  examples :train, rows: "110111010100 101010101010 111111111001 011111010100 101010101010 111101101001 000110011100 101010101010 111101111001 011101010100 101010100010 111101111001 000111010100 101010101010 011101111001"
  examples :train, rows: "010111010100 101010101010 111100111001 011111010100 101000101010 111101111001 010111011100 101010101010 111101111001 010111000100 111110111010 111100101001 010111010100 101000101010 111101101001"
  examples :train, rows: "000111001100 111101101010 111101101001 010110010100 101010101010 111110111001 000111011100 111100101010 111101111001 010011010100 101010100010 110101111001 010111000100 101010101010 111101111001"
  examples :test, rows: "011011010100 101010101010 110001111001 011111010100 101010101010 111101111001 010111010100 101010101010 111101111001 110111110100 100010101010 101100101001 110111000100 111011111010 111101111001"
  examples :test, rows: "000111010100 101000110010 101101111001 010111011100 000011101010 111101111001 011111110100 101010000010 111001111001 110101010100 101011101010 101101111001 010111010100 101010111010 111011111001"
  examples :test, rows: "010111110100 111010101010 111100111001 010111010100 101010101010 101101101001 010101010100 101010101010 110001111001 010100010100 101010101010 101101111001 010110010100 101000101010 111101110001"
  examples :test, rows: "010101010100 101010001010 111101111001 010111010100 101010101010 111101101001 010111010100 101011101010 111101111001 110111010100 101010101010 111101111001 100111000100 110010111010 101101110001"
  examples :test, rows: "010111010100 011110101010 111111111001 010111010100 101010001010 111101101001 010010010100 101010101010 111101111001 010111010100 101010101010 111101111001 010111011100 101010101010 101101101001"
  examples :test, rows: "010111010100 101010100010 111101111001 010101000100 100010101010 101101111001 000011010100 101010001010 111101011001 110110010100 101110101010 101101101001 110011011100 101010101010 111101111001"
end

run :glyphs do
  learn :train, rounds: 200, rate: 0.05, method: :pseudo, seed: 1
  classify :test, labels: "plus cross ring", sweeps: 200, seed: 2
  hold :tl, :no
  hold :tm, :yes
  hold :tr, :no
  hold :mm, :yes
  settle 20_000, seed: 3             # a half-drawn plus: the machine fills in the rest and names it
  show
end

# The negative control: the same machine trained on scrambled labels. Chance is 33%. One run on 90 test
# glyphs scatters widely: over shuffle seeds 4 to 13 the settled readout ran from 12% to 41% (mean 28%)
# and the exact readout from 6% to 53% (mean 28%). Seed 4 is simply the first of those.
model :scrambled do
  examples :train, over: "tl tm tr ml mm mr bl bm br plus cross ring"
  examples :test, over: "tl tm tr ml mm mr bl bm br plus cross ring"
  examples :train, rows: "010111011100 001000101010 100101110001 010111011100 101010101010 111101111001 011111010100 101010100010 011101111001 010111010100 111010101010 101101111001 010101010100 101010010010 110100111001"
  examples :train, rows: "010110010100 001010011010 111101111001 010111110100 101010100010 101101111001 010111000100 101011101010 111101111001 010101010100 101010101010 110011111001 010110010100 101011110010 101100111001"
  examples :train, rows: "110111011100 110010100010 111001111001 010110010100 101010101010 111101010001 001111010100 100010101010 011101101001 010111010100 101110101010 111111110001 010111010100 001010101010 111101110001"
  examples :train, rows: "110111010100 101010101010 111111111001 011111010100 101010101010 111101101001 000110011100 101010101010 111101111001 011101010100 101010100010 111101111001 000111010100 101010101010 011101111001"
  examples :train, rows: "010111010100 101010101010 111100111001 011111010100 101000101010 111101111001 010111011100 101010101010 111101111001 010111000100 111110111010 111100101001 010111010100 101000101010 111101101001"
  examples :train, rows: "000111001100 111101101010 111101101001 010110010100 101010101010 111110111001 000111011100 111100101010 111101111001 010011010100 101010100010 110101111001 010111000100 101010101010 111101111001"
  examples :test, rows: "011011010100 101010101010 110001111001 011111010100 101010101010 111101111001 010111010100 101010101010 111101111001 110111110100 100010101010 101100101001 110111000100 111011111010 111101111001"
  examples :test, rows: "000111010100 101000110010 101101111001 010111011100 000011101010 111101111001 011111110100 101010000010 111001111001 110101010100 101011101010 101101111001 010111010100 101010111010 111011111001"
  examples :test, rows: "010111110100 111010101010 111100111001 010111010100 101010101010 101101101001 010101010100 101010101010 110001111001 010100010100 101010101010 101101111001 010110010100 101000101010 111101110001"
  examples :test, rows: "010101010100 101010001010 111101111001 010111010100 101010101010 111101101001 010111010100 101011101010 111101111001 110111010100 101010101010 111101111001 100111000100 110010111010 101101110001"
  examples :test, rows: "010111010100 011110101010 111111111001 010111010100 101010001010 111101101001 010010010100 101010101010 111101111001 010111010100 101010101010 111101111001 010111011100 101010101010 101101101001"
  examples :test, rows: "010111010100 101010100010 111101111001 010101000100 100010101010 101101111001 000011010100 101010001010 111101011001 110110010100 101110101010 101101101001 110011011100 101010101010 111101111001"
  shuffle :train, labels: "plus cross ring", seed: 4
end

run :scrambled do
  learn :train, rounds: 200, rate: 0.05, method: :pseudo, seed: 1
  classify :test, labels: "plus cross ring", sweeps: 200, seed: 2
end
