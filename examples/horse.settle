# Muybridge's horse (1878, public domain) played on a grid of 15,000 p-bits, one per pixel.
# The 15 frames ship beside this file in horse/frames/ (150 x 100 PGM; horse/frames/SOURCE.txt says where
# they come from). It writes horse/still.pgm and the played frames to horse/out/, both ignored by git.
# Run it from settle-rs:
#   cargo run --release -- examples/horse.settle
model :horse do
  grid :img, width: 150, height: 100, smooth: 0          # no pulls: the best quality measured for yes/no things
  img.lean_from "horse/frames/horse_00.pgm", by: 1
end

run :horse do
  settle 200, seed: 1
  img.show_as "horse/still.pgm"       # the yes-rate of each pixel, as a grey
  play :img, frames: "horse/frames/", out: "horse/out/", sweeps: 10, warm: :yes, seed: 1
end
