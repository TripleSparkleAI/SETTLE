# Factoring as settling, in the column encoding (the default since 2026-10-06): bits of p and q, one helper thing
# per product of two bits, and carry bits, so each column of the long multiplication is pulled toward N's digit in
# that column. Pairwise pulls only, so the helpers are needed. `encoding: :rosenberg` asks for the older form.
model :semiprime do
  factor :f, number: 143
end
model :prime do
  factor :f, number: 127                               # prime: no answer exists
end

run :semiprime do
  anneal 10_000, temperature: 0.55, seed: 1            # temperature = largest pull / 10, so the start is hot
  f.solution
end
run :prime do
  anneal 10_000, temperature: 0.6, seed: 1
  f.solution                                           # must say NOT VALID
end
